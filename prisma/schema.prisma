generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}

enum EstadoFisico {
  NOVO
  BOM_ESTADO
  USADO_LEVE
  USADO_MODERADO
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  INSERVIVEL
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  EM_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

enum TipoAnalise {
  EFICIENCIA_OPERACIONAL
  RENTABILIDADE_EQUIPAMENTO
  VIDA_UTIL_PREDITIVA
}

enum StatusTarefa {
  PENDENTE
  PROCESSANDO
  CONCLUIDO
  FALHOU
}

enum FormatoExportacao {
  JSON
  CSV
}

model Usuario {
  id           String       @id @default(uuid())
  usuario      String       @unique
  hashSenha    String
  papel        PapelUsuario
  ativo        Boolean      @default(true)
  ultimoAcesso DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("usuarios")
}

model Organizacao {
  id                String    @id @default(uuid())
  razaoSocial       String
  cnpj              String    @unique
  inscricaoEstadual String
  enderecoCompleto  String
  telefone          String
  email             String
  dataCadastro      DateTime  @default(now())
  ativo             Boolean   @default(true)
  versao            Int       @default(1)
  contrato          Contrato?
  lotes             Lote[]
  apiKeys           ApiKey[]

  @@map("organizacoes")
}

model Contrato {
  id                  String      @id @default(uuid())
  organizacaoId       String      @unique
  dataAssinatura      DateTime
  dataVencimento      DateTime
  clausulas           Json
  valorMensal         Float
  renovacaoAutomatica Boolean     @default(false)
  versao              Int         @default(1)
  organizacao         Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  @@map("contratos")
}

model Lote {
  id                  String        @id @default(uuid())
  dataEntrada         DateTime
  dataInicioTriagem   DateTime?
  dataFimTriagem      DateTime?
  operadorTriagem     String?
  organizacaoId       String
  notaFiscal          String
  transportadora      String
  statusProcessamento StatusLote    @default(RECEBIDO)
  observacoes         String?
  versao              Int           @default(1)
  organizacao         Organizacao   @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  equipamentos        Equipamento[]

  @@index([organizacaoId])
  @@index([dataEntrada])
  @@map("lotes")
}

model Equipamento {
  id                       String             @id @default(uuid())
  codigoBarrasInterno      String             @unique
  tipo                     TipoEquipamento
  marca                    String
  modelo                   String
  anoFabricacao            Int
  estadoFisico             EstadoFisico
  pesoQuilogramas          Float
  valorEstimadoRecuperacao Float
  loteId                   String
  posicaoNoLote            Int
  statusRastreamento       StatusRastreamento @default(AGUARDANDO_TRIAGEM)
  versao                   Int                @default(1)
  lote                     Lote               @relation(fields: [loteId], references: [id], onDelete: Cascade)
  movimentacoes            Movimentacao[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([loteId])
  @@index([tipo])
  @@map("equipamentos")
}

model Movimentacao {
  id             String        @id @default(uuid())
  equipamentoId  String
  dataHora       DateTime      @default(now())
  origem         String
  destino        String
  responsavel    String
  observacao     String?
  estadoAnterior EstadoFisico?
  estadoNovo     EstadoFisico?
  equipamento    Equipamento   @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)

  @@index([equipamentoId])
  @@map("movimentacoes")
}

model ApiKey {
  id              String      @id @default(uuid())
  nomeParceiro    String
  organizacaoId   String
  prefixo         String
  chaveHash       String      @unique
  permissoes      String[]
  limitePorMinuto Int         @default(60)
  ativa           Boolean     @default(true)
  expiraEm        DateTime?
  ultimoUso       DateTime?
  createdAt       DateTime    @default(now())
  organizacao     Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  @@index([organizacaoId])
  @@map("api_keys")
}

model ResultadoAnalitico {
  id                String             @id @default(uuid())
  tipo              TipoAnalise
  referenciaPeriodo String
  parametros        Json
  resumoMetricas    Json
  detalhes          Json
  origemExecucao    String
  geradoEm          DateTime           @default(now())
  previsoesVidaUtil PrevisaoVidaUtil[]

  @@index([tipo, geradoEm])
  @@map("resultados_analiticos")
}

model PrevisaoVidaUtil {
  id                      String             @id @default(uuid())
  resultadoAnaliticoId    String
  tipoEquipamento         TipoEquipamento
  coeficienteAngular      Float
  intercepto              Float
  rQuadrado               Float
  idadeMediaAtualAnos     Float
  vidaUtilRemanescenteAnos Float
  anoPrevistoInservivel   Int
  amostraTamanho          Int
  calculadoEm             DateTime           @default(now())
  resultadoAnalitico      ResultadoAnalitico @relation(fields: [resultadoAnaliticoId], references: [id], onDelete: Cascade)

  @@index([resultadoAnaliticoId])
  @@index([tipoEquipamento])
  @@map("previsoes_vida_util")
}

model TarefaRelatorio {
  id                   String            @id @default(uuid())
  bullJobId            String?
  apiKeyId             String?
  organizacaoId        String?
  tipoAnalise          TipoAnalise
  formato              FormatoExportacao
  status               StatusTarefa      @default(PENDENTE)
  tentativas           Int               @default(0)
  erroMensagem         String?
  caminhoArquivo       String?
  webhookUrl           String?
  resultadoAnaliticoId String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  concluidoEm          DateTime?

  @@index([status])
  @@map("tarefas_relatorio")
}
